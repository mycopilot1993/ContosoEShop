<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - gitactionswithdemo.razor</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/gitactionswithdemo.razor.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">gitactionswithdemo.razor</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <label class="me-2 mb-0 text-muted">Theme</label>
                        <div id="theme-picker" class="btn-group btn-group-sm" role="group" aria-label="Theme picker">
                            <button type="button" class="btn btn-outline-secondary theme-swatch" data-theme="default" title="Default" aria-pressed="false">
                                <span class="swatch swatch-default" aria-hidden="true"></span>
                                <span class="visually-hidden">Default theme</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary theme-swatch" data-theme="theme-slate" title="Slate" aria-pressed="false">
                                <span class="swatch swatch-slate" aria-hidden="true"></span>
                                <span class="visually-hidden">Slate theme</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary theme-swatch" data-theme="theme-sunrise" title="Sunrise" aria-pressed="false">
                                <span class="swatch swatch-sunrise" aria-hidden="true"></span>
                                <span class="visually-hidden">Sunrise theme</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary theme-swatch" data-theme="theme-forest" title="Forest" aria-pressed="false">
                                <span class="swatch swatch-forest" aria-hidden="true"></span>
                                <span class="visually-hidden">Forest theme</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary theme-swatch" data-theme="theme-ocean" title="Ocean" aria-pressed="false">
                                <span class="swatch swatch-ocean" aria-hidden="true"></span>
                                <span class="visually-hidden">Ocean theme</span>
                            </button>
                            <button type="button" class="btn btn-outline-secondary theme-swatch" data-theme="theme-pastel" title="Pastel" aria-pressed="false">
                                <span class="swatch swatch-pastel" aria-hidden="true"></span>
                                <span class="visually-hidden">Pastel theme</span>
                            </button>
                        </div>
                        <div class="ms-3">
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                <span class="me-2 text-muted">Hello, @User.Identity.Name</span>
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Logout">Logout</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Login">Login</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - gitactionswithdemo.razor - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
