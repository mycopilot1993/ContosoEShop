@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Contoso E-Shop</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<!-- Top promotional panel -->
<section class="top-panel my-4 p-4 rounded-3 shadow-sm">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h2 class="top-panel-title">Discover Contoso Collections</h2>
            <p class="top-panel-sub">Seasonal picks and curated outfits — hand selected for comfort and style. Explore
                our latest arrivals and limited editions.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-page="/Create" class="btn btn-lg btn-primary">Add New Product</a>
        </div>
    </div>
</section>

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Products</h2>
        @* <a asp-page="/Create" class="btn btn-success">Create Product</a> *@
    </div>
    @if (Model.Products == null || !Model.Products.Any())
    {
        <p>No products available.</p>
    }
    else
    {
        <div class="row">
            @foreach (var p in Model.Products)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name" />
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@p.Name</h5>
                            <p class="card-text">@p.Description</p>
                            <p class="card-text"><strong>@p.Price.ToString("C")</strong></p>
                            <div class="mt-auto d-flex gap-2">
                                <a asp-page="/Edit" asp-route-id="@p.Id" class="btn btn-primary btn-sm">Edit</a>
                                <a asp-page="/Delete" asp-route-id="@p.Id" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>